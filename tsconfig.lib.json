{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./lib",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "zero-antd-dep/*": ["./local/zero-element-antd/src/*"]
    },
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["src"],
  "exclude": ["src/pages", "src/main.tsx", "src/router", "src/models", "src/global.ts", "src/zero-antd-dep.ts", "src/zero-antd-dep.js", "src/config.ts", "src/devConfig.ts", "**/*.test.ts", "**/*.test.tsx", "node_modules", "lib"]
}
